rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User's own data ───────────────────────────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Pairing codes — root collection ───────────────────────────────────────
    match /pairingCodes/{code} {
      allow read, write: if true;
    }

    // ── Devices — agent can write its own device doc ──────────────────────────
    // Note: agent uses Firebase SDK without auth.
    // For MVP: allow writes if the parent's UID is known.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if true;  // Tighten after MVP
    }

    // ── Device Rules — agent needs to read rules ──────────────────────────────
    match /users/{userId}/devices/{deviceId}/rules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Installed Apps — agent needs to upload its apps ───────────────────────
    match /users/{userId}/devices/{deviceId}/installedApps/{appId} {
      allow read, write: if true;
    }

    // Commands - parent creates commands; unauthenticated agent reads and marks them done.
    match /users/{userId}/devices/{deviceId}/commands/{commandId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    function deviceScreenshotToken(userId, deviceId) {
      return get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.screenshotUploadToken;
    }

    function hasValidScreenshotToken(userId, deviceId) {
      return deviceScreenshotToken(userId, deviceId) is string
        && request.resource.data.uploadToken == deviceScreenshotToken(userId, deviceId);
    }

    // Screenshots - agent can create metadata only with this device's upload token.
    match /users/{userId}/devices/{deviceId}/screenshots/{screenshotId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if (request.auth != null && request.auth.uid == userId) || hasValidScreenshotToken(userId, deviceId);
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if (request.auth != null && request.auth.uid == userId)
        || (resource.data.uploadToken == deviceScreenshotToken(userId, deviceId));
    }

    // Alerts - agent can write alerts.
    match /users/{userId}/alerts/{alertId} {
      allow read, write: if true;  // Tighten after MVP
    }
  }
}
