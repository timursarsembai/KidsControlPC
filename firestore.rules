rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function activeParentAccess(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/parentAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/parentAccess/$(request.auth.uid)).data.status == 'active';
    }

    function canManageUser(userId) {
      return isOwner(userId) || activeParentAccess(userId);
    }

    // True if the signed-in user is the registered agent for the given device.
    // agentUid is written to the device doc by the pairDevice / registerAgentUid Cloud Functions.
    // Legacy devices (paired before v1.1.92) may not have agentUid yet — allow any
    // authenticated user until the agent self-registers via registerAgentUid CF.
    function isDeviceAgent(userId, deviceId) {
      let storedUid = get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.get('agentUid', null);
      return isSignedIn()
        && (storedUid == null || storedUid == request.auth.uid);
    }

    // ── User root document (e.g. pauseAllRules flag) ─────────────────────────
    // Agents read this to check pauseAllRules; any authenticated user (anonymous
    // or real) can read. Writes require parent ownership.
    match /users/{userId} {
      allow read: if canManageUser(userId) || isSignedIn();
      allow write: if canManageUser(userId);
    }

    // ── User's own profile ────────────────────────────────────────────────────
    match /users/{userId}/profile/{document} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/parentInvitations/{invitationId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/parentAccess/{parentUid} {
      allow read: if canManageUser(userId) || (isSignedIn() && request.auth.uid == parentUid);
      allow write: if false;
    }

    // ── Pairing codes — read/write only via Cloud Functions (admin SDK) ───────
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // ── Devices ───────────────────────────────────────────────────────────────
    match /users/{userId}/devices/{deviceId} {
      allow read: if canManageUser(userId) || isDeviceAgent(userId, deviceId);
      allow write: if canManageUser(userId) || isDeviceAgent(userId, deviceId);
    }

    // ── Device Rules ──────────────────────────────────────────────────────────
    match /users/{userId}/devices/{deviceId}/rules/{ruleId} {
      allow read: if canManageUser(userId) || isDeviceAgent(userId, deviceId);
      allow write: if canManageUser(userId);
    }

    // ── Installed Apps ────────────────────────────────────────────────────────
    match /users/{userId}/devices/{deviceId}/installedApps/{appId} {
      allow read: if canManageUser(userId) || isDeviceAgent(userId, deviceId);
      allow write: if canManageUser(userId) || isDeviceAgent(userId, deviceId);
    }

    function deviceScreenshotToken(userId, deviceId) {
      return get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.screenshotUploadToken;
    }

    function hasValidNewCommandToken(userId, deviceId) {
      return request.resource.data.uploadToken is string
        && request.resource.data.uploadToken == deviceScreenshotToken(userId, deviceId);
    }

    function hasValidExistingCommandToken(userId, deviceId) {
      return resource.data.uploadToken is string
        && resource.data.uploadToken == deviceScreenshotToken(userId, deviceId);
    }

    // Commands - parent creates via CF (which validates and adds token server-side);
    // agent reads and marks only token-matched commands.
    match /users/{userId}/devices/{deviceId}/commands/{commandId} {
      allow create: if canManageUser(userId)
        && hasValidNewCommandToken(userId, deviceId);
      allow read: if canManageUser(userId)
        || hasValidExistingCommandToken(userId, deviceId);
      allow update: if hasValidExistingCommandToken(userId, deviceId)
        && hasValidNewCommandToken(userId, deviceId);
      allow delete: if canManageUser(userId);
    }

    function hasValidScreenshotToken(userId, deviceId) {
      return deviceScreenshotToken(userId, deviceId) is string
        && request.resource.data.uploadToken == deviceScreenshotToken(userId, deviceId);
    }

    // Screenshots - agent can create metadata only with this device's upload token.
    match /users/{userId}/devices/{deviceId}/screenshots/{screenshotId} {
      allow read: if canManageUser(userId);
      allow create: if canManageUser(userId) || hasValidScreenshotToken(userId, deviceId);
      allow update: if canManageUser(userId);
      allow delete: if canManageUser(userId)
        || (resource.data.uploadToken == deviceScreenshotToken(userId, deviceId));
    }

    // Alerts - agent writes (any authenticated user writing to the owner's alerts is
    // acceptable; the write comes from a signed-in anonymous agent session).
    match /users/{userId}/alerts/{alertId} {
      allow read: if canManageUser(userId);
      allow write: if isSignedIn();
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    // Agent is authenticated (anonymous), so isSignedIn() replaces the old || true.
    match /users/{userId}/chats/{chatId} {
      allow read: if canManageUser(userId) || isSignedIn();
      allow create: if canManageUser(userId);
      allow update: if canManageUser(userId) || isSignedIn();
      allow delete: if isOwner(userId) || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Activity logs & stats — agent writes via authenticated anonymous session ──
    match /users/{userId}/devices/{deviceId}/activityLogs/{logId} {
      allow read: if canManageUser(userId);
      allow write: if isDeviceAgent(userId, deviceId);
    }

    match /users/{userId}/devices/{deviceId}/activityStats/{date} {
      allow read: if canManageUser(userId);
      allow write: if isDeviceAgent(userId, deviceId);
    }

    match /users/{userId}/chats/{chatId}/messages/{msgId} {
      allow read: if canManageUser(userId) || isSignedIn();
      allow create: if canManageUser(userId) || isSignedIn();
      allow update: if canManageUser(userId) || isSignedIn();
      allow delete: if isOwner(userId);
    }
  }
}
