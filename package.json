{
  "name": "kids-control-pc",
  "version": "1.1.7",
  "description": "Parental control desktop application",
  "main": "out/main/index.js",
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:deploy": "npm run deploy --workspace=web",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "build": {
    "appId": "com.kidscontrol.pc",
    "productName": "KidsControlPC",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "timursarsembai",
        "repo": "KidsControlPC"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "firebase": "^10.12.0",
    "i18next": "^26.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.1"
  }
}
