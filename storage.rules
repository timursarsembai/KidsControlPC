rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function activeParentAccess(userId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(userId)/parentAccess/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(userId)/parentAccess/$(request.auth.uid)).data.status == 'active';
    }

    function canManageUser(userId) {
      return isSignedIn() && (request.auth.uid == userId || activeParentAccess(userId));
    }

    function deviceScreenshotToken(userId, deviceId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/devices/$(deviceId)).data.screenshotUploadToken;
    }

    function hasValidScreenshotToken(userId, deviceId) {
      return deviceScreenshotToken(userId, deviceId) is string
        && request.resource.metadata.uploadToken == deviceScreenshotToken(userId, deviceId);
    }

    match /users/{userId}/devices/{deviceId}/screenshots/{fileName} {
      allow read: if canManageUser(userId);
      allow create: if (canManageUser(userId) || hasValidScreenshotToken(userId, deviceId))
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if canManageUser(userId)
        || (resource.metadata.uploadToken == deviceScreenshotToken(userId, deviceId));
    }

    // Chat file attachments: parent uploads via browser (authenticated),
    // child agent uploads without auth — allow write without auth for now
    // (same pattern as Firestore chat messages which also use || true).
    match /users/{userId}/chats/{chatId}/attachments/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && !request.resource.contentType.matches('video/.*');
      allow delete: if canManageUser(userId);
      allow update: if false;
    }
  }
}
