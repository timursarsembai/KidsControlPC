# Copy to .env and fill in. .env is gitignored — never commit real values.

POSTGRES_DB=kidscontrol
POSTGRES_USER=kidscontrol
POSTGRES_PASSWORD=

# Signs parent access tokens and agent access tokens.
# Generate with: openssl rand -hex 48
JWT_SECRET=

PORT=8092
NODE_ENV=production

# Public origin of the panel, used for CORS and for links in emails.
PUBLIC_ORIGIN=https://kidscontrol.kz

# Whose X-Forwarded-For header is believed: the proxy-network subnet where
# Nginx Proxy Manager lives, and nothing else. Widening this would let a caller
# claim any client address and slip past the rate limit on the login route.
TRUSTED_PROXIES=172.18.0.0/16

# Почта. Пока не задан SMTP_HOST, письма не отправляются, а сервис работает
# как прежде: восстановление пароля отвечает так же, но письмо не уходит.
# Настраивается, когда у kidscontrol.kz появится почтовый ящик в mailcow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KidsControlPC <noreply@kidscontrol.kz>

# Принимать самоподписанный сертификат почтового сервера. Включать ТОЛЬКО для
# отправщика внутри docker-сети этой машины: у внешнего провайдера сертификат —
# единственное доказательство, что вы говорите именно с ним.
SMTP_ALLOW_SELF_SIGNED=false
