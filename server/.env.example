# Copy to .env and fill in. .env is gitignored — never commit real values.

POSTGRES_DB=kidscontrol
POSTGRES_USER=kidscontrol
POSTGRES_PASSWORD=

# Signs parent access tokens and agent access tokens.
# Generate with: openssl rand -hex 48
JWT_SECRET=

PORT=8092
NODE_ENV=production

# Public origin of the panel, used for CORS and for links in emails.
PUBLIC_ORIGIN=https://kidscontrol.kz

# Whose X-Forwarded-For header is believed: the proxy-network subnet where
# Nginx Proxy Manager lives, and nothing else. Widening this would let a caller
# claim any client address and slip past the rate limit on the login route.
TRUSTED_PROXIES=172.18.0.0/16
